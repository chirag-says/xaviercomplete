# Copy to .env and fill in. .env is gitignored and must stay that way.
# In production these are set in the host's secret store, never as a file on disk.
#
# Generate the three secrets with:  npm run keys:generate -- --write
# (the --write form fills this file in place and prints nothing, which is what
# you want whenever someone else is looking at your terminal)

# --- Secrets -----------------------------------------------------------------
# AES-256-GCM key ring. Comma-separated "version:base64key"; highest version is
# current. Mid-rotation this reads e.g. "2:<new>,1:<old>".
# Lose this after real data is loaded and every contact number is unreadable.
DATA_ENCRYPTION_KEYS=

# HMAC-SHA-256 pepper for the login allowlist blind index. A different secret
# from the one above, on purpose: if one leaks, the other still holds.
EMAIL_HMAC_PEPPER=

# Session token signing.
SESSION_SECRET=

# --- Database ----------------------------------------------------------------
# The owner connection, from Supabase → Settings → Database (session pooler).
# Used ONLY by `npm run db:migrate` and `db:verify`. If the password contains
# an @ or a /, URL-encode it (%40, %2F) or the URI parses wrongly.
DATABASE_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# The public site, as the least-privilege sxc_web role. The app refuses to fall
# back to DATABASE_URL in production — that would hand the internet-facing app
# the ability to rename alumni and mint allowlist entries.
WEB_DATABASE_URL=

# The local ingest tool, as sxc_ingest.
INGEST_DATABASE_URL=

# Role passwords, generated by db:migrate on first run. Keep them in the
# password manager; the two URLs above are built from them.
SXC_WEB_PASSWORD=
SXC_ADMIN_PASSWORD=
SXC_INGEST_PASSWORD=

# --- Email (Resend) ----------------------------------------------------------
RESEND_API_KEY=

# Must be a domain verified in Resend. Swapping to sxccaa.org later is this
# line and APP_URL — no code changes.
MAIL_FROM=SXCCAA Alumni <alumni@example.org>
MAIL_REPLY_TO=alumni@example.org

# Public origin, used to build sign-in links and to check request Origin.
# No trailing slash.
APP_URL=http://localhost:3300

# Where "an access request is waiting" goes. The Association's own mailbox —
# often shared, so the message deliberately carries no name, no address and no
# reason. Whoever opens it signs in to the portal to see who it is.
# Unset: requests still queue, and nobody is told they arrived.
ADMIN_NOTIFY_EMAIL=

# Where the general enquiry form on /contact and the "Get in touch" band send
# their messages. Unlike the notification above, these DO carry their contents —
# the message is the point, and it is about the sender, not about any alumnus.
# Defaults to ADMIN_NOTIFY_EMAIL. Unset both and the form says so rather than
# claiming to have sent anything.
ENQUIRY_TO_EMAIL=

# The admin portal's origin, used only to build the "open the portal" link in
# that notification. No trailing slash.
ADMIN_URL=http://localhost:3400

# --- Bot protection ----------------------------------------------------------
# Cloudflare Turnstile. Without these the login form is a free oracle for
# sending mail to any address an attacker cares to try.
#
# Unset in development: verification passes with a warning.
# Unset in production: verification FAILS, and sign-in stops. That is deliberate.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Override the production requirement. Only for a staging box with no keys.
# REQUIRE_TURNSTILE=false

# --- Feature flags -----------------------------------------------------------
# While true, the site renders the synthetic records in src/data/alumni.ts and
# never touches the database. Must be false in production.
USE_DEMO_ALUMNI=true
