  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/node": "^22.20.2",
    "@types/react": "~19.2.2",
    "sharp": "^0.35.4",
    "typescript": "~6.0.3"
  },
  "dependencyRationale": "Versions are the published expo-template-default@sdk-57 pins, read from npm rather than recalled, because SDK 57 postdates the assistant's training cutoff. Reanimated 4 requires react-native-worklets as a separate package and the New Architecture, which is the SDK 57 default. Fonts come from @expo-google-fonts rather than oxvercity/public/fonts because 79 of those 80 files are .woff2, which React Native cannot load; all three families are Google Fonts, so these packages are the same typefaces as .ttf."
}
