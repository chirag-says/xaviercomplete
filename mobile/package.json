{
  "name": "sxccaa-alumni",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel",
    "web": "expo start --web --port 8081",
    "android": "expo run:android",
